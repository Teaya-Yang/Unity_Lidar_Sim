Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Name: root
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 10
      Plane Cell Count: 60
      Color: 90; 90; 90
      Alpha: 0.5
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Axes: true
      Marker Scale: 5
    - Class: rviz_default_plugins/PointCloud2
      Name: LiDAR cloud
      Enabled: true
      Topic:
        Value: /point_cloud
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 2
      Color Transformer: AxisColor
      Axis: Z
      Decay Time: 0
      Position Transformer: XYZ
    - Class: rviz_default_plugins/MarkerArray
      Name: MPPI rollouts
      Enabled: true
      Topic:
        Value: /viz/rollouts
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Namespaces:
        {}
    - Class: rviz_default_plugins/MarkerArray
      Name: Occlusion boundaries
      Enabled: true
      Topic:
        Value: /viz/occlusion_boundaries
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Namespaces:
        {}
    - Class: rviz_default_plugins/MarkerArray
      Name: Dynamic keep-outs
      Enabled: true
      Topic:
        Value: /viz/dynamic_obstacles
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Namespaces:
        {}
    - Class: rviz_default_plugins/MarkerArray
      Name: Detected boxes
      Enabled: true
      Topic:
        Value: /viz/detections
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Namespaces:
        {}
    - Class: rviz_default_plugins/MarkerArray
      Name: Ego and goal
      Enabled: true
      Topic:
        Value: /viz/ego
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Namespaces:
        {}
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 120
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 1.0
      Yaw: 3.9
      Target Frame: <Fixed Frame>
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1600
  Displays:
    collapsed: false
