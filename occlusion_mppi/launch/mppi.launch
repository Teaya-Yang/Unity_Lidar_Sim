<launch>
    <!-- Occlusion-aware MPPI. Replaces keyboard_control.py as the source of
         /planning/pos_cmd, so do NOT run both at once.

         Full stack (four terminals):
           roslaunch occlusion_boundary wall_test.launch
           roslaunch occlusion_boundary occlusion_boundary_walltest.launch
           roslaunch occlusion_mppi mppi.launch
           roslaunch rog_map_example rviz.launch
    -->
    <!-- /Odometry_imu is FAST-LIO's 200 Hz IMU-extrapolated pose and requires the
         FAST-LIO stack to be running. With bare MARSIM (use_dynamics:=false)
         nothing publishes it and the planner sits silent waiting for a pose.
         Pass /lidar_slam/odom for that case. -->
    <arg name="odom_topic" default="/Odometry_imu"/>

    <node name="occlusion_mppi" pkg="occlusion_mppi" type="mppi_node.py" output="screen">
        <param name="odom_topic" value="$(arg odom_topic)"/>
        <!-- 3 => the ego climbs and can fly OVER an occluder; 2 is the old
             fixed-altitude baseline. In 2D the occupancy test folds z away, so a
             wall is solid at every altitude and there is no way over it. -->
        <param name="dim" value="3"/>
        <!-- [x,y] or [x,y,z]. With three elements the z is the goal altitude and
             goal_z below is ignored; with two it is padded with goal_z. In 2D any
             third element is dropped. -->
        <rosparam param="goal">[8.0, 15.0, 1.0]</rosparam>
        <!-- Altitude a 2-element goal is padded to. Defaults to cruise_z. -->
        <param name="goal_z" value="1.0"/>
        <!-- 3D: the takeoff/hold altitde only, not a constraint. 2D: enforced. -->
        <param name="cruise_z" value="1.0"/>
        <param name="boundary_topic" value="/rm_node/occlusion_frontier"/>
        <!-- Occlusion geometry (boundary_planar, z_band, boundary_z_min, d_safe,
             v_target, t_grow_max, occ_resolution, occ_z_band): SHARED with
             occlusion_viz.launch. Edit the yaml, never this file. These two
             nodes disagreeing is not a visible failure; occlusion_viz simply
             draws a keep-out the planner is not enforcing. -->
        <rosparam command="load"
                  file="$(find occlusion_mppi)/config/occlusion_common.yaml"/>
        <!-- Level flight: a_z and v_z are held at zero in every rollout and in
             the command, so the ego stays at cruise_z. Defaults to whatever
             boundary_planar is, since a planar keep-out cannot score a climb and
             would let MPPI spend vertical authority for nothing. Set explicitly
             to decouple the two. -->
        <param name="lock_altitude" value="true"/>
        <param name="occupancy_topic" value="/rm_node/rog_map/inf_occ"/>
        <param name="w_collision" value="100"/>
        <!-- Obstacle keep-out: hold d_clear metres from the SURFACE of the
             nearest occupied voxel. This is around real matter; d_safe in the
             yaml is around the occlusion frontier, which is empty space at the
             mouth of a shadow. The two sets barely overlap - an observed wall
             face has no frontier near it, a doorway has frontier and no wall.

             w_clear is the cost per stage for sitting exactly on the surface,
             ramping linearly to 0 at d_clear and continuing to climb inside, so
             a rollout leaving an occupied cell outscores one driving deeper.
             That continuation is what w_collision, being binary, cannot express.

             NOTE inf_occ is ALREADY inflated by ROG-Map, so the true standoff is
             d_clear plus that inflation radius. Subtract it here if the ego
             gives walls a wider berth than intended. 0 disables the term. -->
        <param name="w_clear" value="200.0"/>
        <param name="d_clear" value="1.5"/>
        <!-- Altitude bounds, 3D only. inf_occ contains NO floor: ROG-Map's
             virtual_ground_height is a z-test inside isOccupied() and never
             reaches the occupancy buffer, so boxSearch never publishes it. In a
             wall-only scene there is then nothing below the wall's bottom edge
             and diving under it is a free way around. These put the floor back.
             Leave empty to disable. -->
        <param name="z_min" value="0.5"/>
        <param name="z_max" value=""/>
        <!-- Flip to false for the baseline run: collision only, no occlusion. -->
        <param name="use_occlusion" value="false  "/>
        <!-- How the K rollouts collapse into one command. "best" = argmin,
             "mean" = textbook softmax-weighted MPPI. The mean is an average of
             trajectories, not a trajectory: at a corner the batch splits into
             go-left and go-right modes and their mean drives into the occluder
             between them, which is why ~rollouts drew a plan clearing the corner
             while the ego breached the wall. Switch back to "mean" once the two
             modes are no longer symmetric. -->
        <param name="selection" value="mean"/>
        <param name="rate" value="10.0"/>
        <param name="samples" value="100"/>
        <param name="horizon" value="30"/>

        <!-- Arrow from the ego to the voxel setting d_occ. Costs one extra
             KD-tree index lookup per tick; set false to drop it entirely. -->
        <param name="show_nearest" value="true"/>
        <!-- Ball above the drone: red once the MEASURED pose is inside an
             occupied voxel. Green while the drone is visibly inside a wall means
             that wall is not in the occupancy set at all, which is the only thing
             that can make the collision term silently never fire. -->
        <param name="show_occupied" value="true"/>

        <!-- d_safe / v_target / t_grow_max now come from occlusion_common.yaml
             above. w_soft and d_infl are the COST's shape, not the geometry, and
             occlusion_viz does not use them, so they stay here. -->
        <param name="w_soft" value="50.0"/>
        <param name="d_infl" value="1.0"/>

        <!-- Settling authority. The MPPIConfig default of 1.2 gives damping of
             ~0.12*v^2 per stage against a goal pull of 2*d: rushing the goal
             always beats braking for it and the ego overshoots, the at-goal
             latch releases at 1.5*goal_tol, and it orbits forever. 15 makes
             braking win inside the last metre. -->
        <param name="w_v" value="15.0"/>

        <param name="v_max" value="1.0"/>
        <param name="a_max" value="3.0"/>
    </node>
</launch>
